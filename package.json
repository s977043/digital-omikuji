      "tar": ">=7.5.11",
      "@xmldom/xmldom": ">=0.9.10",
      "minimatch": ">=5.1.8",
      "diff": ">=8.0.3",
      "yaml": ">=2.8.3",
      "@tootallnate/once": ">=3.0.1"
    }
  }
}
