{
  "name": "digital-omikuji",
  "version": "1.3.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "test": "jest",
    "test:e2e:web": "playwright test",
    "test:coverage": "jest --coverage",
    "ci:check": "pnpm install --frozen-lockfile --prefer-offline && pnpm exec tsc --noEmit && pnpm lint && pnpm lint:md && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint . --fix",
    "optimize:images": "node scripts/optimize-images.js",
    "validate:skills": "node .agent/skills/validate-skills.js"
  },
  "dependencies": {
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@react-native-async-storage/async-storage": "3.0.2",
    "@sentry/react-native": "^8.7.0",
    "@types/react-dom": "^19.0.0",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "^17.0.8",
    "expo-modules-autolinking": "^3.0.24",
    "expo-router": "~6.0.23",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.4",
    "moti": "^0.30.0",
    "nativewind": "^4.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.2",
    "react-native": "0.84.1",
    "react-native-css-interop": "^0.2.3",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.8.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-native-community/cli": "^20.1.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.14",
    "eas-cli": "^18.7.0",
    "eslint": "^10.2.0",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.14",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.4",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3"
