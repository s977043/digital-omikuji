{
  "name": "digital-omikuji",
  "version": "1.3.1",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "test": "jest",
    "test:e2e:web": "playwright test",
    "test:coverage": "jest --coverage",
    "ci:check": "pnpm install --frozen-lockfile --prefer-offline && pnpm exec tsc --noEmit && pnpm lint && pnpm lint:md && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint . --fix",
    "optimize:images": "node scripts/optimize-images.js",
    "validate:skills": "node .agent/skills/validate-skills.js"
  },
  "dependencies": {
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^7.11.0",
    "@types/react-dom": "^19.2.3",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "^57.0.2",
    "expo-router": "~57.0.30",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.4",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.2",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.3",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.10.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-native-community/cli": "^20.1.2",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^10.2.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.3",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "undici": ">=6.25.0",
      "picomatch": ">=3.0.2",
      "node-forge": ">=1.4.0",
      "tar": ">=7.5.11",
      "@xmldom/xmldom": ">=0.9.10",
      "minimatch": ">=5.1.8",
      "diff": ">=8.0.3",
      "yaml": ">=2.8.3",
      "@tootallnate/once": ">=3.0.1"
    }
  }
}
